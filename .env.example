# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (LOCAL & PRODUCTION VERCEL + SUPABASE)
# ==============================================================================

# 1. DATABASE CONFIGURATION (SUPABASE POSTGRESQL)
# ------------------------------------------------------------------------------
# DATABASE_URL: Menggunakan Supabase Transaction Pooler (Port 6543)
# Gunakan connection string dari menu: Project Settings -> Database -> Connection Pooling -> Mode: Transaction
# Contoh:
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Menggunakan Direct Connection (Port 5432) khusus Prisma Migrations / db push
# Gunakan connection string dari menu: Project Settings -> Database -> Connection String -> URI
# Contoh:
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 2. NEXTAUTH AUTHENTICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Di Vercel Production, ganti dengan URL domain deployment Anda (contoh: https://pandai-learning.vercel.app)
NEXTAUTH_URL="https://your-domain.vercel.app"

# Kunci rahasia JWT NextAuth (minimal 32 karakter acak). Generate menggunakan: openssl rand -base64 32
NEXTAUTH_SECRET="your_production_secret_key_at_least_32_characters_long"

# 3. SUPABASE STORAGE (OPSIONAL / AVATAR UPLOADS)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# SUPABASE_AVATARS_BUCKET="avatars"
