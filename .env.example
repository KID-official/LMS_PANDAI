# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (LOCAL & PRODUCTION VERCEL + NEON SINGAPORE)
# ==============================================================================

# 1. DATABASE CONFIGURATION (NEON SERVERLESS POSTGRESQL - SINGAPORE)
# ------------------------------------------------------------------------------
# DATABASE_URL: Menggunakan Neon Connection Pooling (-pooler) untuk lalu lintas aplikasi serverless
DATABASE_URL="postgresql://[USER]:[PASSWORD]@ep-[PROJECT-ENDPOINT]-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# DIRECT_URL / DATABASE_URL_UNPOOLED: Menggunakan Neon Direct Connection (non-pooler) untuk migrasi Prisma
DIRECT_URL="postgresql://[USER]:[PASSWORD]@ep-[PROJECT-ENDPOINT].c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://[USER]:[PASSWORD]@ep-[PROJECT-ENDPOINT].c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 2. NEXTAUTH AUTHENTICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Di Vercel Production, ganti dengan URL domain deployment Anda (contoh: https://pandai-learning.vercel.app)
NEXTAUTH_URL="https://your-domain.vercel.app"

# Kunci rahasia JWT NextAuth (minimal 32 karakter acak). Generate menggunakan: openssl rand -base64 32
NEXTAUTH_SECRET="your_production_secret_key_at_least_32_characters_long"

# 3. NEON OBJECT STORAGE (S3-COMPATIBLE - BUCKET PUBLIC READ)
# ------------------------------------------------------------------------------
# Kredensial otomatis ditarik saat menjalankan `neon deploy`
AWS_ACCESS_KEY_ID="nak_live_your_access_key_id"
AWS_SECRET_ACCESS_KEY="nsk_live_your_secret_access_key"
AWS_ENDPOINT_URL_S3="https://br-[BRANCH-ID].storage.c-4.ap-southeast-1.aws.neon.tech"
AWS_REGION="ap-southeast-1"
NEON_STORAGE_BUCKET="pandai-learning"
